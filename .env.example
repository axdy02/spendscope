# npm start requires a real PostgreSQL database. Node >=22 supports --env-file.
DATABASE_URL=postgresql://spendscope:spendscope_local@localhost:5432/spendscope
PORT=8012
# SEED_DEMO=1 adds synthetic data once without changing imports.
# TEST_DATABASE_URL=postgresql://spendscope:spendscope_local@localhost:5432/spendscope_test
# Optional, server-side only. Core analytics work without a key.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# DEV_ORIGIN=http://localhost:5173

{
  "name": "spendscope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A React and Express spending explorer with PostgreSQL and an explicit local demo adapter.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "demo": "node server/index.js --demo",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:postgres": "node --test --test-name-pattern=PostgreSQL tests/integration.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.18",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "motion": "^12.23.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
